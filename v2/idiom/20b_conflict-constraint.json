{
    "id": "I20b",
    "name": "Conflict Constraint",
    "variables": ["X", "Y"],
    "nodes": [
        {
            "id": "P1",
            "type": "premise",
            "proposition": "$X conflicts with $Y.",
            "predicate": "conflict",
            "args": ["X", "Y"]
        },
        {
            "id": "P2",
            "type": "premise",
            "proposition": "$Y is acceptable.",
            "predicate": "acceptable",
            "args": ["Y"]
        },
        {
            "id": "C",
            "type": "conclusion",
            "proposition": "$X is acceptable (to be false).",
            "predicate": "acceptable",
            "args": ["X"]
        }
    ],
    "edges": [
        {
            "id": "E1",
            "from": "P2",
            "to": "P1"
        },
        {
            "id": "E2",
            "from": "C",
            "to": "P1"
        }
    ]
}