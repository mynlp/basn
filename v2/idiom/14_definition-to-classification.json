{
    "id": "I14",
    "name": "Definition to Classification",
    "variables": ["X", "C", "D"],
    "nodes": [
        {
            "id": "P1",
            "type": "premise",
            "proposition": "$X fits $D.",
            "predicate": "fit",
            "args": ["X", "D"]
        },
        {
            "id": "P2",
            "type": "premise",
            "proposition": "$C is defined as $D.",
            "predicate": "defined_as",
            "args": ["C", "D"]
        },
        {
            "id": "C",
            "type": "conclusion",
            "proposition": "$X is $C.",
            "predicate": "is",
            "args": ["X", "C"]
        }
    ],
    "edges": [
        {
            "id": "E1",
            "from": "P1",
            "to": "C"
        },
        {
            "id": "E2",
            "from": "P2",
            "to": "C"
        }
    ]
}